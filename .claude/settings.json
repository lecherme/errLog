{
  "permissions": {
    "allow": [
      "Bash(node tools/safe-commit.mjs check *)",
      "Bash(node tools/safe-commit.mjs inspect *)"
    ],
    "ask": [
      "Bash(node tools/safe-commit.mjs commit *)",
      "Bash(node tools/safe-commit.mjs push *)"
    ],
    "deny": [
      "Bash(node tools/safe-commit.mjs commit *--push*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git commit-tree *)",
      "Bash(git update-index *)",
      "Bash(git -C * add *)",
      "Bash(git -C * commit *)",
      "Bash(git -C * push *)",
      "Bash(/usr/bin/git add *)",
      "Bash(/usr/bin/git commit *)",
      "Bash(/usr/bin/git push *)",
      "Bash(command git add *)",
      "Bash(command git commit *)",
      "Bash(command git push *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/safe-commit-gate.mjs\""
          }
        ]
      }
    ]
  }
}
